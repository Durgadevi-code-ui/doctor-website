# Copy this file to .env and fill in real values.
# .env is loaded automatically via python-dotenv (see app/config.py).
# NEVER commit your real .env file to version control.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-long-random-string

# --- Database (Supabase Postgres) ---
# Get this from your Supabase project: Project Settings -> Database ->
# Connection string -> "URI" tab. Use the "Session pooler" connection
# (port 6543) for most app traffic, or the direct connection
# (port 5432) if your host can reach it directly. Either
# postgresql:// or postgresql+psycopg2:// works - app/config.py
# normalizes the scheme and adds sslmode=require automatically if
# it's missing. See README "Supabase Setup" for the full walkthrough.
#
# Example (values below are placeholders, not real credentials):
DATABASE_URL=postgresql://postgres.your-project-ref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Used only when running the automated test suite (tests/).
# Point this at a SEPARATE Supabase project (or a local Postgres
# instance) - never at your production database, since tests create
# and drop tables.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/customer_management_test

# Pagination defaults for GET /api/customers
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Admin 2FA (email OTP delivery) ---
# Leave SMTP_HOST unset for local development - OTP codes will be
# written to the application log (logs/app.log) instead of emailed,
# so the login flow is still fully testable without a mail server.
# Set all four for production. Any standard SMTP provider works
# (SendGrid, Postmark, AWS SES, Gmail app password, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM_EMAIL=no-reply@agenticatoms.com
OTP_VALIDITY_MINUTES=10

# To create the first admin account (after running migrations), use
# the CLI - see README "Admin 2FA Setup":
#   flask create-admin
